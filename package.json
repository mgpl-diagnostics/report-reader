{
  "name": "@mgpl-diagnostics/report-reader",
  "version": "0.1.0",
  "description": "Reads partner-lab report PDFs (Hy Patho Lab, Clinova Pathlabs): results, patient and sample details, dates, signatories with their signature images, and NABL accreditation evidence, as typed JSON. Uses the PDF text layer; no OCR.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": "github:mgpl-diagnostics/report-reader",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "report-reader": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "LICENSE",
    "llms-full.txt"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "test": "tsx scripts/make-fixtures.ts && tsx --test test/extract.test.ts",
    "recall": "tsx scripts/recall.ts",
    "validate": "tsx scripts/validate.ts",
    "prepare": "tsup",
    "llms": "node scripts/llms-full.mjs @mgpl-diagnostics/report-reader README.md AGENTS.md docs llms.txt package.json src scripts test"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "pdf-lib": "^1.17.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
